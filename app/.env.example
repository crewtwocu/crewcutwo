# Server
PORT=3847
PUBLIC_BASE_URL=http://localhost:3847

# SQLite path (optional)
# DB_PATH=./data/crew.db

# XMR Checkout (leave unset for full mock dry-run)
# Auth header: Authorization: ApiKey $XMRCHECKOUT_API_KEY
# XMRCHECKOUT_API_KEY=
# XMRCHECKOUT_BASE_URL=https://xmrcheckout.com/api/core
# XMRCHECKOUT_WEBHOOK_SECRET=
# WEBHOOK_SECRET=   # alias accepted by webhook handler
# XMRCHECKOUT_STORE_ID=

# When API key is set, mock pay is disabled unless:
# ALLOW_MOCK_PAY=true

# Optional: copy/link secrets from box path (loaded automatically if present, not committed):
# /workspace/crew-lolipop/xmrcheckout.env

# Invoice / match pay window (seconds). Default 3600 (~1h, XMR Checkout-like).
# INVOICE_TTL_SECONDS=3600

# Mock-only (skip shared /workspace/crew-lolipop secrets). Docker Compose sets this to 1 by default.
# CREW_MOCK_ONLY=1

# Docker live: copy this file to .env (gitignored), set XMRCHECKOUT_API_KEY and CREW_MOCK_ONLY=0.
# Compose substitutes those into the match service. Never put secrets in the Dockerfile.

# Dual-party connection reveal grace (seconds). After both pay, connection
# (code + jobBrief + handoffHint) stays retrievable for this window so hub +
# both side pages can poll successfully. Default 900 (15 minutes). Min 30.
# REVEAL_GRACE_SECONDS=900

# —— Privacy-preserving contact / Get-a-reply (optional) ——
# One-shot outbound only. No DB write of visitor contact.
# Ops destination (required for real delivery; stub used when SMTP/Twilio missing):
# CREW_CONTACT_OPS_EMAIL=ops@example.com
# CREW_CONTACT_OPS_PHONE=+15551234567

# SMTP (email reply requests + email-to-ops for callbacks when Twilio unset)
# CREW_SMTP_HOST=smtp.example.com
# CREW_SMTP_PORT=587
# CREW_SMTP_SECURE=false
# CREW_SMTP_USER=
# CREW_SMTP_PASS=
# CREW_SMTP_FROM=noreply@example.com

# Twilio SMS (callback requests preferred path)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15557654321
